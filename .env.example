# =============================================================================
# RE:TREAT YOURSELF — Environment Variable Reference
# =============================================================================
#
# SECURITY CLASSIFICATION OF EACH KEY:
#
#   PUBLIC   — Safe to commit, safe in browser bundles, safe to expose.
#   SERVER   — Server-only. Never expose in client code or commit to git.
#   CLI/CI   — Used only by Supabase CLI / GitHub Actions. Never in app code.
#
# THREE-FILE SYSTEM (Next.js 16+):
#
#   .env.public       Committed. Contains NEXT_PUBLIC_* defaults for production.
#   .env.example      Committed. This file — documentation + template.
#   .env.local        GITIGNORED. Your real secrets. Copy from this file.
#
# Do not set a key to empty string if .env.public should supply it.
# An empty string overrides and silently breaks Supabase clients. Omit instead.
#
# =============================================================================


# =============================================================================
# SECTION A — SUPABASE: CLIENT-SAFE (PUBLIC)
# =============================================================================
# Inlined at build time. Safe to expose in browser bundles.
# Supabase data security depends entirely on Row Level Security (RLS) rules
# being correctly configured — not on keeping these keys secret.
#
# WHERE TO FIND:
#   Supabase Dashboard → Your Project → Settings → API Keys
#   → "Publishable and secret API keys" tab → Publishable key
#   URL: https://supabase.com/dashboard/project/<ref>/settings/api-keys
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Legacy aliases — still supported but prefer the names above for new projects.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...   # Maps to PUBLISHABLE_KEY internally


# =============================================================================
# SECTION B — SUPABASE: SERVER-ONLY SECRETS
# =============================================================================
# ⚠️  NEVER expose these in client code, browser bundles, or logs.
# ⚠️  These bypass Row Level Security entirely.
#
# WHERE TO FIND:
#   Supabase Dashboard → Settings → API Keys → Secret keys → reveal (👁 icon)
#   URL: https://supabase.com/dashboard/project/<ref>/settings/api-keys
# =============================================================================

SUPABASE_SECRET_KEY=sb_secret_<your-key>

# Legacy alias — still supported but prefer SUPABASE_SECRET_KEY above.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # Maps to SECRET_KEY internally


# =============================================================================
# SECTION C — SUPABASE: CLI & CI/CD
# =============================================================================
# Used only by the Supabase CLI and GitHub Actions.
# Never read by Next.js application code.
#
# SUPABASE_DB_PASSWORD
#   WHERE TO FIND:
#     - The password you set when creating the Supabase project.
#     - To reset: Supabase Dashboard → Settings → Database → Reset database password
#     - URL: https://supabase.com/dashboard/project/<ref>/settings/database
#   REQUIRED FOR: supabase link, db push, db pull, db dump, db reset
#
# SUPABASE_ACCESS_TOKEN
#   WHERE TO FIND:
#     Supabase Dashboard → Account → Access Tokens → Generate new token
#     URL: https://supabase.com/dashboard/account/tokens
#     Format: sbp_<your-token>   (Personal Access Token — NOT a project key)
#   REQUIRED FOR: CI/CD pipelines, automated deploys, supabase link in non-interactive env
# =============================================================================

SUPABASE_DB_PASSWORD=<your-database-password>
SUPABASE_ACCESS_TOKEN=sbp_<your-personal-access-token>


# =============================================================================
# SECTION D — APPLICATION
# =============================================================================

# Canonical public URL of the site (no trailing slash).
# Used in: OG/Twitter meta images, absolute URL generation, email templates.
# Local dev: keep as localhost. Production: set to your live domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator secret — protects /api/operator/* endpoints (publish-retreat, create-match).
# Generate a strong random string: openssl rand -base64 32
# WHERE TO USE: Set as GitHub Actions secret + inject into hosting env.
# ⚠️  SERVER ONLY. Never expose in client code.
OPERATOR_SECRET=<random-strong-secret>

# Secret for HMAC-signing the admin session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠️  SERVER ONLY. Never expose in client code. Rotating this invalidates all active admin sessions.
SESSION_SECRET=replace-with-32-byte-random-base64url

# Optional server-side canonical URL (non-NEXT_PUBLIC, server-only code only).
# APP_URL=https://retreatyourself.network


# =============================================================================
# SECTION E — LEGAL PAGES
# =============================================================================
# Controls whether /privacy, /terms, /cookies are publicly accessible.
# Set to "true" once legal pages have been reviewed and approved.
# Managed in src/proxy.ts.
NEXT_PUBLIC_LEGAL_PAGES_VISIBLE=false

# Controls whether the advertising packages (Banner/Feature/Social/Package)
# render on /for-retreat-owners. Keep "false" until Andrew confirms the prices
# are current — see docs/20_execution/STAKEHOLDER_DECISIONS_ANDREW.md #6.
NEXT_PUBLIC_OWNER_AD_PACKAGES_VISIBLE=false


# =============================================================================
# SECTION F — MAIL (server-only)
# =============================================================================
# Controls how transactional email is sent.
# Full documentation: docs/10_architecture/CONTACT_MAIL.md
#
# MAIL_PROVIDER choices:
#   auto   — Use Resend if RESEND_API_KEY is set, else SMTP if complete, else skip.
#   resend — Require Resend; error if key missing.
#   smtp   — Require SMTP; error if missing.
#   none   — Disable all mail (useful for testing form storage without email).

MAIL_PROVIDER=auto

# Sender address (must be a verified domain on Resend, or a mailbox on SMTP host).
MAIL_FROM="Re:Treat Yourself <noreply@retreatyourself.network>"

# Inbox that receives operator notifications from the contact form.
# Visitor email becomes Reply-To — never the To address.
CONTACT_NOTIFY_TO=ops@retreatyourself.network


# --- Option 1: Resend (recommended) ---
# WHERE TO FIND: https://resend.com/api-keys → Create API key
# Format: re_<alphanumeric>
# RESEND_API_KEY=re_<your-key>


# --- Option 2: SMTP / cPanel ---
# WHERE TO FIND: cPanel → Email Accounts → Connect Devices (shows SMTP settings)
# Port 587 + SECURE=false → STARTTLS  |  Port 465 + SECURE=true → SSL/TLS
SMTP_HOST=mail.retreatyourself.network
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@retreatyourself.network
SMTP_PASSWORD=<your-smtp-password>


# =============================================================================
# SECTION G — n8n WEBHOOKS (optional)
# =============================================================================
# APIs persist data and send mail first. n8n is optional for extra automation
# (CRM, Slack, alternate channels). Do NOT duplicate user receipts via n8n.
# See docs/10_architecture/N8N_AUTOMATION_MATRIX.md for ownership rules.
#
# WHERE TO FIND: Your n8n instance → Workflow → Webhook node → copy URL
# N8N_FORM_SUBMISSION_URL=https://your-n8n.example.com/webhook/form-handler
# N8N_WEBHOOK_SECRET=<shared-hmac-secret>


# =============================================================================
# SECTION H — RATE LIMITING (optional overrides)
# =============================================================================
# Defaults are defined in src/lib/rate-limit.ts.
# Note: in-memory per Node process — scale-out multiplies effective allowance.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
# DISABLE_SEC_FETCH_SITE_GUARD=false


# =============================================================================
# SECTION I — RUNTIME
# =============================================================================
# NODE_ENV=production
# PORT=3000
