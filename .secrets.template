# Re:Treat Yourself — local secrets store template
#
# Copy this file to `.secrets` and fill in real values.
# `.secrets` is gitignored — never commit it.
# Transfer real values via a password manager or secure channel.
#
# What this file is NOT:
#   - Not a replacement for `.env.local` (which the app reads for runtime env vars).
#   - Not a substitute for GitHub Actions secrets (which the deploy pipeline injects).
#
# What this file IS:
#   - A local credential reference for the developer/operator, structured for
#     easy grep and sourcing. The app does not read this file directly.
#
# Last updated: 2026-07-23

# --- Email mailboxes (retreatyourself.network, created via cPanel uapi) ---
# Managed at: cPanel > Email Accounts > retreatyourself.network
# See: docs/30_infrastructure/MAIL.md

MAILBOX_GROW_USER=grow@retreatyourself.network
MAILBOX_GROW_PASS=<password from cPanel or password manager>

MAILBOX_TEAM_USER=team@retreatyourself.network
MAILBOX_TEAM_PASS=<password from cPanel or password manager>

MAILBOX_NOREPLY_USER=noreply@retreatyourself.network
MAILBOX_NOREPLY_PASS=<password from cPanel — this is also SMTP_PASSWORD in GitHub Actions secrets>

# --- Admin panel ---
# The single shared password that gates /admin/* (OPERATOR_SECRET).
# Also stored as: GitHub Actions secret OPERATOR_SECRET, CloudLinux env var.
# See: docs/20_execution/HANDOVER_GUIDE.md §4 for how the admin panel is used.

OPERATOR_SECRET=<value from GitHub Actions > Settings > Secrets > OPERATOR_SECRET>

# Secret for HMAC-signing the admin session cookie — distinct from OPERATOR_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Also stored as: GitHub Actions secret SESSION_SECRET, CloudLinux env var.
# Rotating this value invalidates all active admin sessions (forces re-login).
SESSION_SECRET=<32-byte random base64url — generate with the node one-liner above>

# --- Supabase (EU project, Frankfurt eu-central-1) ---
# Project ref: ruzxlccdoywshavwtulc
# Publishable key is in .env.public (safe to commit).
# Secret keys are NOT safe to commit — stored here for local reference only.
# Also stored as: GitHub Actions secrets ENV_API_KEY, SUPABASE_SECRET_KEY, SUPABASE_DB_PASSWORD, SUPABASE_ACCESS_TOKEN.
# See: docs/30_infrastructure/SUPABASE_EU.md

SUPABASE_SERVICE_ROLE_KEY=<sb_secret_... value from Supabase dashboard>
SUPABASE_DB_PASSWORD=<from Supabase dashboard > Settings > Database>
SUPABASE_ACCESS_TOKEN=<personal access token from supabase.com/account/tokens>

# --- SSH / cPanel ---
# SSH alias configured in ~/.ssh/config as Host retreatyourself
# See: docs/30_infrastructure/CPANEL_PASSENGER.md

CPANEL_SSH_HOST=<server hostname — from .ssh/config>
CPANEL_SSH_USER=<cPanel username>
# SSH_PRIVATE_KEY is stored in GitHub Actions secrets — not replicated here.

# --- Coolify (Hetzner VPS — staging: retreatyourself.innerflect.tech) ---
# Instance URL and app UUID are set once; webhook secret rotates in Coolify app > Webhooks.
# See: docs/30_infrastructure/COOLIFY_STAGING.md

COOLIFY_INSTANCE_URL=https://coolify.innerflect.tech
COOLIFY_API_TOKEN=<root API token from Coolify > Keys & Tokens>
COOLIFY_PROJECT_ID=<project UUID from Coolify dashboard URL>
COOLIFY_ENVIRONMENT_ID=<environment UUID from Coolify dashboard URL>
COOLIFY_APP_UUID=<application UUID from Coolify app settings>
COOLIFY_WEBHOOK_URL=https://coolify.innerflect.tech/api/v1/deploy?uuid=<APP_UUID>&force=false
# COOLIFY_WEBHOOK_SECRET is stored in GitHub Actions as COOLIFY_TOKEN (not the root API token).
# Generate/rotate in Coolify > Application > Webhooks > manual_webhook_secret_github.
